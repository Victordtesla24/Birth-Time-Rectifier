{
  "name": "containerised-birth-time-rectifier",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "TEST_TAG='@critical' playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:critical:chromium": "TEST_TAG='@critical' playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:ui": "jest --testPathPattern=ui",
    "test:api": "jest --testPathPattern=api",
    "test:integration": "python -m pytest -xvs tests/integration/ --rootdir=tests",
    "test:unit": "python -m pytest -xvs tests/unit/ --rootdir=tests",
    "test:visual": "jest --testMatch='**/*.visual.test.{js,jsx,ts,tsx}' --runInBand",
    "test:update-visual": "jest --testMatch='**/*.visual.test.{js,jsx,ts,tsx}' --runInBand --updateSnapshot",
    "test:performance": "jest --testMatch='**/*.perf.test.(ts|tsx)' --runInBand",
    "test:accessibility": "jest --testMatch='**/*.a11y.test.(ts|tsx)'",
    "test:hooks": "jest --testMatch='**/hooks/**/*.test.(ts|tsx)'",
    "test:memory": "jest --testMatch='**/*.memory.test.(ts|tsx)' --runInBand",
    "test:framerate": "jest --testMatch='**/*.framerate.test.(ts|tsx)' --runInBand",
    "test:rendertime": "jest --testMatch='**/*.rendertime.test.(ts|tsx)' --runInBand",
    "test:aggregate": "node scripts/aggregate-test-results.js",
    "test:ci": "jest --ci --coverage && playwright test",
    "verify-api": "python tests/utils/verify_api_key.py",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}'",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "clean": "find . -type d -name __pycache__ -exec rm -rf {} +; find . -type d -name .pytest_cache -exec rm -rf {} +; find . -type d -name *.egg-info -exec rm -rf {} +",
    "setup": "pip install -r python/requirements.txt"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^4.1.3",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@mui/system": "^5.11.4",
    "@react-three/drei": "^9.56.10",
    "@react-three/fiber": "^8.10.1",
    "axios": "^1.6.7",
    "d3": "^7.9.0",
    "events": "^3.3.0",
    "formik": "^2.4.6",
    "framer-motion": "^11.0.3",
    "gsap": "^3.12.7",
    "iron-session": "^8.0.4",
    "jspdf": "^3.0.0",
    "lodash": "^4.17.21",
    "next": "^15.2.2",
    "node-mocks-http": "^1.16.2",
    "p5": "^1.9.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.42.1",
    "react-toastify": "^9.1.1",
    "swr": "^2.2.4",
    "three": "^0.148.0",
    "three-mesh-bvh": "^0.5.24",
    "throttle-debounce": "^5.0.0",
    "tweakpane": "^4.0.5",
    "yup": "^1.6.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.24.0",
    "@mui/x-date-pickers": "^7.26.0",
    "@playwright/test": "^1.51.1",
    "@swc/jest": "^0.2.37",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/events": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.30",
    "@types/p5": "^1.7.6",
    "@types/react": "^18.2.67",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.2.22",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/three": "^0.148.1",
    "@types/throttle-debounce": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.13",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "history": "^5.3.0",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.4.0",
    "jest-junit": "^16.0.0",
    "jest-performance": "^1.0.0",
    "jest-playwright-preset": "^3.0.1",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^15.2.0",
    "msw": "^2.7.0",
    "postcss": "^8.4.21",
    "prettier": "^3.1.1",
    "puppeteer": "^24.4.0",
    "react-app-polyfill": "^3.0.0",
    "react-router-dom": "^6.29.0",
    "react-test-renderer": "^18.2.0",
    "start-server-and-test": "^2.0.3",
    "stylelint": "^14.16.1",
    "tailwindcss": "^3.2.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.2",
    "typescript-plugin-css-modules": "^4.1.1",
    "whatwg-fetch": "^3.6.20"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest.setup.js"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "cacheDirectories": [
    ".next/cache"
  ]
}
