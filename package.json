{
  "name": "containerised-birth-time-rectifier",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:e2e": "playwright test",
    "test:e2e:critical": "TEST_TAG='@critical' playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:critical:chromium": "TEST_TAG='@critical' playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:ui": "jest --testPathPattern=ui",
    "test:api": "jest --testPathPattern=api",
    "test:integration": "python -m pytest -xvs tests/integration/ --rootdir=tests",
    "test:unit": "python -m pytest -xvs tests/unit/ --rootdir=tests",
    "test:visual": "jest --testMatch='**/*.visual.test.{js,jsx,ts,tsx}' --runInBand",
    "test:update-visual": "jest --testMatch='**/*.visual.test.{js,jsx,ts,tsx}' --runInBand --updateSnapshot",
    "verify-api": "python tests/utils/verify_api_key.py",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "clean": "find . -type d -name __pycache__ -exec rm -rf {} +; find . -type d -name .pytest_cache -exec rm -rf {} +; find . -type d -name *.egg-info -exec rm -rf {} +",
    "setup": "pip install -r python/requirements.txt"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@hookform/resolvers": "^4.1.3",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.4",
    "@mui/system": "^5.11.4",
    "@react-three/drei": "^9.56.10",
    "@react-three/fiber": "^8.10.1",
    "axios": "^1.3.2",
    "events": "^3.3.0",
    "framer-motion": "^8.5.0",
    "iron-session": "^8.0.4",
    "jspdf": "^3.0.0",
    "lodash": "^4.17.21",
    "next": "^15.2.2",
    "node-mocks-http": "^1.16.2",
    "react": "^18.2.0",
    "react-datepicker": "^8.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.42.1",
    "react-toastify": "^9.1.1",
    "three": "^0.148.0",
    "three-mesh-bvh": "^0.5.24",
    "throttle-debounce": "^5.0.0",
    "yup": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/runtime": "^7.24.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/events": "^3.0.3",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.191",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.148.1",
    "@types/throttle-debounce": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.13",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.4.0",
    "jest-watch-typeahead": "^2.2.2",
    "msw": "^1.3.2",
    "postcss": "^8.4.21",
    "prettier": "^2.8.3",
    "puppeteer": "^24.4.0",
    "react-test-renderer": "^18.2.0",
    "stylelint": "^14.16.1",
    "tailwindcss": "^3.2.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2",
    "typescript-plugin-css-modules": "^4.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest.setup.js"
    ]
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "cacheDirectories": [
    ".next/cache"
  ]
}
